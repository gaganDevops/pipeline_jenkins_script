pipeline {

    agent any

    parameters {

        choice(
            name: 'APPLICATION',
            choices: ['Retail', 'Corporate'],
            description: 'Select Application'
        )
    }

    options {

        timeout(
            time: 10,
            unit: 'MINUTES'
        )

        disableConcurrentBuilds()

        retry(2)

        timestamps()
    }

    stages {

        stage('Checkout') {

            steps {

                script {

                    def repoURL = 'https://github.com/gaganDevops/pipeline_jenkins_script.git'

                    git branch: 'main', url: repoURL
                }
            }
        }

        stage('Build') {

            steps {

                dir(params.APPLICATION) {

                    sh 'mvn clean package'
                }
            }
        }

        stage('Deploy') {

            steps {

                script {

                    echo "Deploying ${params.APPLICATION}"
     ssh '''
sudo cp Retail/target/retail.war /opt/tomcat/webapps/
'''
                    // Deployment command will come here
                    // sh './deploy.sh'
                }
            }
        }
    }

    post {

        success {

            echo "Deployment has been completed successfully"
        }

        failure {

            echo "Deployment has failed"
        }

        always {

            echo "Pipeline execution completed"
        }
    }
}
